#!/usr/bin/env python3
# tmux-load
# Restore tmux topology from a tmux-dump JSON file.
#
# Usage:
#   tmux-load path/to/tmux.json
#   tmux-load --session name path/to/tmux.json
#   tmux-load -s name path/to/tmux.json
#   tmux-load -f path/to/tmux.json
#   tmux-load -a path/to/tmux.json
#   tmux-load -c path/to/tmux.json
#   tmux-load --no-run-commands path/to/tmux.json

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
from typing import Any, Dict, List, Optional, Tuple


DEBUG_LOG_INITIALIZED = False


def ensure_debug_log() -> None:
    global DEBUG_LOG_INITIALIZED
    if DEBUG_LOG_INITIALIZED:
        return
    DEBUG_LOG_INITIALIZED = True
    try:
        with open("tmux_helper_debug.log", "w", encoding="utf-8") as f:
            f.write("")
    except Exception:
        pass


def run_tmux(args: List[str]) -> Tuple[int, str, str]:
    if os.environ.get("TMUX_HELPER_DEBUG") == "1":
        try:
            ensure_debug_log()
            with open("tmux_helper_debug.log", "a", encoding="utf-8") as f:
                f.write("tmux " + " ".join(args) + "\n")
        except Exception:
            pass
    proc = subprocess.run(["tmux"] + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    return proc.returncode, proc.stdout, proc.stderr


PENDING_COMMANDS: List[List[str]] = []


def tmux_queue(args: List[str]) -> None:
    PENDING_COMMANDS.append(args)


def tmux_flush() -> None:
    if not PENDING_COMMANDS:
        return
    combined: List[str] = []
    for idx, cmd in enumerate(PENDING_COMMANDS):
        if idx:
            combined.append(";")
        combined.extend(cmd)
    PENDING_COMMANDS.clear()
    rc, out, err = run_tmux(combined)
    if rc != 0:
        raise RuntimeError(err.strip() or f"tmux failed: {' '.join(combined)}")


def tmux_ok(args: List[str]) -> bool:
    tmux_flush()
    rc, _, _ = run_tmux(args)
    return rc == 0


def tmux_out(args: List[str]) -> str:
    tmux_flush()
    rc, out, err = run_tmux(args)
    if rc != 0:
        raise RuntimeError(err.strip() or f"tmux failed: {' '.join(args)}")
    return out


def session_exists(name: str) -> bool:
    return tmux_ok(["has-session", "-t", name])


def kill_session(name: str) -> None:
    tmux_queue(["kill-session", "-t", name])


def unique_session_name(base: str) -> str:
    if not session_exists(base):
        return base
    idx = 1
    while True:
        candidate = f"{base}({idx})"
        if not session_exists(candidate):
            return candidate
        idx += 1


def session_target(name: str) -> str:
    return f"{name}:"


def list_pane_ids_by_index(target: str) -> Dict[int, str]:
    out = tmux_out(["list-panes", "-t", target, "-F", "#{pane_index}\t#{pane_id}"])
    res: Dict[int, str] = {}
    for line in out.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t", 1)
        if len(parts) != 2:
            continue
        try:
            idx = int(parts[0])
        except ValueError:
            continue
        res[idx] = parts[1]
    return res


def restore_window_indexes(session_name: str, window_id_by_index: Dict[int, str]) -> None:
    if not window_id_by_index:
        return
    out = tmux_out(
        ["list-windows", "-t", session_target(session_name), "-F", "#{window_index}"]
    )
    existing_indexes = [int(line) for line in out.splitlines() if line.strip().isdigit()]
    temporary_index = max(existing_indexes + list(window_id_by_index) + [0]) + 1
    for window_id in window_id_by_index.values():
        tmux_out(["move-window", "-s", window_id, "-t", f"{session_name}:{temporary_index}"])
        temporary_index += 1
    for index, window_id in sorted(window_id_by_index.items()):
        tmux_out(["move-window", "-s", window_id, "-t", f"{session_name}:{index}"])


def park_windows(session_name: str, window_ids: List[str], reserved_indexes: List[int]) -> None:
    out = tmux_out(
        ["list-windows", "-t", session_target(session_name), "-F", "#{window_index}"]
    )
    existing_indexes = [int(line) for line in out.splitlines() if line.strip().isdigit()]
    temporary_index = max(existing_indexes + reserved_indexes + [0]) + 1
    for window_id in window_ids:
        tmux_out(["move-window", "-s", window_id, "-t", f"{session_name}:{temporary_index}"])
        temporary_index += 1


def current_session_name() -> Optional[str]:
    rc, out, _ = run_tmux(["display-message", "-p", "#{session_name}"])
    if rc != 0:
        return None
    return out.strip() or None


def current_window_id() -> Optional[str]:
    try:
        out = tmux_out(["display-message", "-p", "#{window_id}"])
    except Exception:
        return None
    return out.strip() or None


def is_empty_session(name: str, allow_current_pane: bool) -> bool:
    try:
        windows = tmux_out(["list-windows", "-t", session_target(name), "-F", "#{window_index}"])
        win_lines = [ln for ln in windows.splitlines() if ln.strip()]
        if len(win_lines) != 1:
            return False

        panes = tmux_out(
            [
                "list-panes",
                "-t",
                session_target(name),
                "-F",
                "#{pane_id}\t#{pane_index}\t#{pane_current_command}\t#{pane_in_mode}",
            ]
        )
        pane_lines = [ln for ln in panes.splitlines() if ln.strip()]
        if len(pane_lines) != 1:
            return False

        parts = pane_lines[0].split("\t")
        if len(parts) < 4:
            return False
        pane_id = parts[0].strip()
        cmd = parts[2].strip()
        in_mode = parts[3].strip()
        if in_mode == "1":
            return False

        current_pane = os.environ.get("TMUX_PANE") if allow_current_pane else None
        if current_pane and pane_id == current_pane:
            return True

        shells = {"sh", "bash", "zsh", "fish", "nu", "tcsh", "csh", "ksh"}
        return cmd in shells or cmd == ""
    except Exception:
        return False


def is_empty_current_session() -> bool:
    if "TMUX" not in os.environ:
        return False
    sname = current_session_name()
    if not sname:
        return False
    return is_empty_session(sname, allow_current_pane=True)


def normalize_path(path: str) -> str:
    if path.startswith("file://"):
        path = path[len("file://") :]
        if not path.startswith("/"):
            idx = path.find("/")
            if idx != -1:
                path = path[idx:]
    return path


def restore_directory(path: Any, fallback_dir: str) -> str:
    normalized = normalize_path(str(path or ""))
    if normalized and not os.path.isabs(normalized):
        normalized = os.path.abspath(os.path.join(fallback_dir, normalized))
    if normalized and os.path.isdir(normalized):
        return normalized
    return fallback_dir if fallback_dir and os.path.isdir(fallback_dir) else ""


def normalize_start_command(cmd: Any) -> str:
    if cmd is None:
        return ""
    if isinstance(cmd, list):
        return shlex.join([str(item) for item in cmd])
    return str(cmd)


def command_argv_from_value(cmd: Any) -> List[str]:
    if cmd is None:
        return []
    if isinstance(cmd, list):
        return [str(item) for item in cmd]
    if isinstance(cmd, str):
        try:
            return shlex.split(cmd)
        except ValueError:
            return cmd.split()
    return []


def run_plan_from_processes(processes: Any) -> Tuple[List[str], str]:
    # Run plan from pane processes (only when --run-commands):
    # - No processes: run nothing.
    # - One process:
    #   - shell: run nothing (avoid launching a second shell).
    #   - non-shell: run directly via tmux new-window/split-window -- <cmd>.
    # - Two+ processes:
    #   - first is shell: start shell, then send-keys the second command.
    #   - first is non-shell: run the first command directly.
    if not isinstance(processes, list) or not processes:
        return ([], "")
    foreground = [process for process in processes if isinstance(process, dict) and process.get("foreground")]
    if foreground:
        foreground_groups = {process.get("pgid") for process in foreground}
        if len(foreground) != 1 or len(foreground_groups) != 1:
            return ([], "")
        process = foreground[-1]
        command = process.get("command")
        if not isinstance(command, list) or not command:
            return ([], "")
        first_bin = os.path.basename(str(command[0])).lstrip("-")
        shells = {"sh", "bash", "zsh", "fish", "nu", "tcsh", "csh", "ksh"}
        if first_bin in shells:
            return ([], "")
        processes_by_pid = {
            item.get("pid"): item
            for item in processes
            if isinstance(item, dict) and isinstance(item.get("pid"), int)
        }
        parent_pid = process.get("ppid")
        seen = set()
        while isinstance(parent_pid, int) and parent_pid not in seen:
            seen.add(parent_pid)
            parent = processes_by_pid.get(parent_pid)
            if not parent:
                break
            parent_command = parent.get("command")
            if isinstance(parent_command, list) and parent_command:
                parent_bin = os.path.basename(str(parent_command[0])).lstrip("-")
                if parent_bin in shells:
                    return ([], normalize_start_command(command))
            parent_pid = parent.get("ppid")
        return (command_argv_from_value(command), "")
    first = processes[0] if isinstance(processes[0], dict) else {}
    first_cmd = first.get("command") if isinstance(first, dict) else None
    first_cmd_list = first_cmd if isinstance(first_cmd, list) else []
    if not first_cmd_list:
        return ([], "")
    first_bin = os.path.basename(str(first_cmd_list[0])).lstrip("-")
    shells = {"sh", "bash", "zsh", "fish", "nu", "tcsh", "csh", "ksh"}
    if len(processes) == 1:
        if first_bin in shells:
            return ([], "")
        return (command_argv_from_value(first_cmd_list), "")
    if first_bin in shells:
        if len(processes) > 1 and isinstance(processes[1], dict):
            second_cmd = processes[1].get("command")
            if isinstance(second_cmd, list) and second_cmd:
                return ([], normalize_start_command(second_cmd))
        return ([], "")
    return (command_argv_from_value(first_cmd_list), "")


def run_plan_from_pane(pane: Any) -> Tuple[List[str], str]:
    if not isinstance(pane, dict):
        return ([], "")
    shell_command = pane.get("shell_command")
    if isinstance(shell_command, dict):
        command = shell_command.get("command")
        if shell_command.get("running") and isinstance(command, str) and command.strip():
            return ([], command)
        return ([], "")
    return run_plan_from_processes(pane.get("processes"))


def session_name_from_dump(data: Any) -> Optional[str]:
    if not isinstance(data, dict):
        return None
    if "sessions" in data and isinstance(data.get("sessions"), list):
        sessions = data.get("sessions") or []
        if not sessions:
            return None
        session = sessions[0] or {}
        return session.get("name") or session.get("session_name")
    if "windows" in data or "name" in data or "session_name" in data:
        return data.get("name") or data.get("session_name")
    return None


def validate_dump(data: Any) -> Dict[str, Any]:
    if not isinstance(data, dict):
        raise ValueError("tmux dump must be a JSON object")
    if "sessions" in data:
        sessions = data.get("sessions")
        if not isinstance(sessions, list) or len(sessions) != 1 or not isinstance(sessions[0], dict):
            raise ValueError("tmux dump must contain exactly one session")
        session = sessions[0]
    else:
        session = data
    windows = session.get("windows")
    if not isinstance(windows, list) or not windows:
        raise ValueError("tmux dump must contain at least one window")
    window_indexes = set()
    for window in windows:
        if not isinstance(window, dict):
            raise ValueError("each window must be an object")
        try:
            window_index = int(window.get("index", 0))
        except (TypeError, ValueError):
            raise ValueError("window indexes must be integers") from None
        if window_index in window_indexes:
            raise ValueError(f"duplicate window index: {window_index}")
        window_indexes.add(window_index)
        panes = window.get("panes")
        if not isinstance(panes, list) or not panes:
            raise ValueError("each window must contain at least one pane")
        pane_indexes = set()
        for pane in panes:
            if not isinstance(pane, dict):
                raise ValueError("each pane must be an object")
            try:
                pane_index = int(pane.get("index", 0))
            except (TypeError, ValueError):
                raise ValueError("pane indexes must be integers") from None
            if pane_index in pane_indexes:
                raise ValueError(f"duplicate pane index: {pane_index}")
            pane_indexes.add(pane_index)
    return session


def ensure_window_panes(
    target: str,
    panes: List[Dict[str, Any]],
    run_commands: bool,
    sort_by_index: bool = True,
) -> None:
    if not panes:
        return

    panes_sorted = sorted(panes, key=lambda p: p.get("index", 0)) if sort_by_index else list(panes)
    run_plan_by_index: Dict[int, Tuple[List[str], str]] = {}
    if run_commands:
        for pane in panes_sorted:
            try:
                idx = int(pane.get("index", 0))
            except Exception:
                continue
            run_plan_by_index[idx] = run_plan_from_pane(pane)
    prev_pane: Optional[Dict[str, Any]] = panes_sorted[0]
    for pane in panes_sorted[1:]:
        path = restore_directory(pane.get("path"), os.getcwd())
        cmd = ["split-window", "-t", target]
        if prev_pane:
            prev_geom = prev_pane.get("geometry") or {}
            geom = pane.get("geometry") or {}
            try:
                prev_left = int(prev_geom.get("left"))
                prev_top = int(prev_geom.get("top"))
                left = int(geom.get("left"))
                top = int(geom.get("top"))
                if top == prev_top and left != prev_left:
                    cmd.append("-h")
                elif left == prev_left and top != prev_top:
                    cmd.append("-v")
            except Exception:
                pass
        if path:
            cmd.extend(["-c", path])
        if run_commands:
            try:
                pane_idx = int(pane.get("index", 0))
            except Exception:
                pane_idx = None
            if pane_idx is not None:
                cmd_argv, _ = run_plan_by_index.get(pane_idx, ([], ""))
                if cmd_argv:
                    cmd.append("--")
                    cmd.extend(cmd_argv)
        tmux_queue(cmd)
        prev_pane = pane

    # Apply titles and run commands
    actual_panes = list_pane_ids_by_index(target)
    pane_map: Dict[int, str] = {}
    for pane, actual_index in zip(panes_sorted, sorted(actual_panes)):
        try:
            pane_map[int(pane.get("index", 0))] = actual_panes[actual_index]
        except (TypeError, ValueError):
            continue
    for pane in panes_sorted:
        try:
            idx = int(pane.get("index", 0))
        except Exception:
            continue
        pane_id = pane_map.get(idx)
        if not pane_id:
            continue
        title = pane.get("title") or ""
        if title:
            tmux_queue(["select-pane", "-t", pane_id, "-T", title])

        if run_commands:
            cmd_argv, shell_cmd = run_plan_by_index.get(idx, ([], ""))
            if shell_cmd and not cmd_argv:
                tmux_queue(["send-keys", "-t", pane_id, "-l", shell_cmd])
                tmux_queue(["send-keys", "-t", pane_id, "Enter"])

    # Select active pane if indicated
    active_idx = None
    for pane in panes_sorted:
        if pane.get("active"):
            active_idx = pane.get("index")
            break
    if active_idx is not None:
        try:
            pane_id = pane_map.get(int(active_idx))
        except Exception:
            pane_id = None
        if pane_id:
            tmux_queue(["select-pane", "-t", pane_id])
    tmux_flush()


def apply_window_options(window_id: str, window: Dict[str, Any]) -> None:
    automatic_rename = window.get("automatic_rename")
    if automatic_rename:
        tmux_queue(["set-window-option", "-t", window_id, "automatic-rename", str(automatic_rename)])
    panes = window.get("panes") or []
    pane_indexes = [int(pane.get("index", 0)) for pane in panes]
    if pane_indexes:
        tmux_queue(["set-window-option", "-t", window_id, "pane-base-index", str(min(pane_indexes))])




def restore_from_dump(
    data: Dict[str, Any],
    force: bool,
    append: bool,
    run_commands: bool,
    target_session: Optional[str],
    base_dir: str,
    fallback_dir: str,
) -> None:
    session = validate_dump(data)
    sname = target_session or session.get("name") or session.get("session_name")
    if not sname:
        raise RuntimeError("missing target session name")

    current_session = current_session_name() if "TMUX" in os.environ else None
    in_tmux = current_session is not None
    target_is_current = bool(current_session and sname == current_session)

    windows = session.get("windows") or []
    windows_sorted = sorted(windows, key=lambda w: int(w.get("index", 0)))

    exists = session_exists(sname)
    session_empty = False
    if exists:
        if force:
            if target_is_current:
                session_empty = True
            else:
                staging_name = unique_session_name(f"__tmux_load_{sname}")
                try:
                    restore_from_dump(
                        data,
                        force=False,
                        append=False,
                        run_commands=run_commands,
                        target_session=staging_name,
                        base_dir=base_dir,
                        fallback_dir=fallback_dir,
                    )
                    backup_name = unique_session_name(f"__tmux_load_backup_{sname}")
                    tmux_out(["rename-session", "-t", sname, backup_name])
                    try:
                        tmux_out(["rename-session", "-t", staging_name, sname])
                    except Exception:
                        tmux_out(["rename-session", "-t", backup_name, sname])
                        raise
                    kill_session(backup_name)
                    tmux_flush()
                except Exception:
                    if session_exists(staging_name):
                        kill_session(staging_name)
                        tmux_flush()
                    raise
                return
        else:
            session_empty = False if append else is_empty_session(sname, allow_current_pane=target_is_current)
            if not append and not session_empty:
                raise RuntimeError(
                    f"target session '{sname}' is not empty (use -f to clear or -a to append)"
                )

    if not exists:
        sname = unique_session_name(sname)

    reuse_current = bool(exists and target_is_current and (force or session_empty))
    append_mode = bool(exists and (append or session_empty or reuse_current))

    window_id_by_index: Dict[int, str] = {}
    original_window_ids: List[str] = []

    if append_mode:
        if force and target_is_current:
            original_window_ids = [
                line.strip()
                for line in tmux_out(
                    ["list-windows", "-t", session_target(sname), "-F", "#{window_id}"]
                ).splitlines()
                if line.strip()
            ]
        elif reuse_current:
            original_window_id = current_window_id()
            if original_window_id:
                original_window_ids = [original_window_id]
        elif session_empty:
            win_id = tmux_out(["list-windows", "-t", session_target(sname), "-F", "#{window_id}"]).strip()
            if win_id:
                original_window_ids = [win_id]
        for win in windows_sorted:
            wname = win.get("name") or ""
            panes = win.get("panes") or []
            wpath = ""
            if panes:
                wpath = restore_directory(panes[0].get("path"), fallback_dir)
            window_dir = base_dir if base_dir and not window_id_by_index else wpath
            cmd_argv: List[str] = []
            shell_cmd = ""
            if run_commands and panes:
                cmd_argv, shell_cmd = run_plan_from_pane(panes[0])
            cmd = [
                "new-window",
                "-P",
                "-t",
                session_target(sname),
                "-n",
                wname,
            ]
            if window_dir:
                cmd.extend(["-c", window_dir])
            cmd.extend(["-F", "#{window_id}"])
            if cmd_argv:
                cmd.append("--")
                cmd.extend(cmd_argv)
            win_id = tmux_out(cmd).strip()
            window_id_by_index[int(win.get("index", 0))] = win_id
            ensure_window_panes(win_id, panes, run_commands, sort_by_index=False)
            apply_window_options(win_id, win)

            layout = win.get("layout") or ""
            if layout:
                tmux_queue(["select-layout", "-t", win_id, layout])

            if win.get("zoomed"):
                tmux_queue(["resize-pane", "-Z", "-t", win_id])

        if (reuse_current or session_empty) and original_window_ids:
            park_windows(sname, original_window_ids, list(window_id_by_index))
    else:
        session_dir = base_dir or fallback_dir
        cmd = ["new-session", "-d", "-s", sname, "-n", "__tmux_load__"]
        if session_dir:
            cmd.extend(["-c", session_dir])
        cmd.extend(["-P", "-F", "#{window_id}"])
        placeholder_id = tmux_out(cmd).strip()

        for win in windows_sorted:
            widx = int(win.get("index", 0))
            wname = win.get("name") or ""
            panes = win.get("panes") or []
            wpath = ""
            if panes:
                wpath = restore_directory(panes[0].get("path"), fallback_dir)
            window_dir = base_dir if base_dir and not window_id_by_index else wpath
            cmd_argv: List[str] = []
            shell_cmd = ""
            if run_commands and panes:
                cmd_argv, shell_cmd = run_plan_from_pane(panes[0])
            cmd = [
                "new-window",
                "-P",
                "-t",
                session_target(sname),
                "-n",
                wname,
            ]
            if window_dir:
                cmd.extend(["-c", window_dir])
            cmd.extend(["-F", "#{window_id}"])
            if cmd_argv:
                cmd.append("--")
                cmd.extend(cmd_argv)
            win_id = tmux_out(cmd).strip()
            window_id_by_index[widx] = win_id
            ensure_window_panes(win_id, panes, run_commands)
            apply_window_options(win_id, win)

            layout = win.get("layout") or ""
            if layout:
                tmux_queue(["select-layout", "-t", win_id, layout])

            if win.get("zoomed"):
                tmux_queue(["resize-pane", "-Z", "-t", win_id])

        if placeholder_id:
            tmux_queue(["kill-window", "-t", placeholder_id])

    if not append:
        tmux_flush()
        restore_window_indexes(sname, window_id_by_index)

    # Select active window if specified
    active_idx = None
    for win in windows_sorted:
        if win.get("active"):
            active_idx = win.get("index")
            break
    if active_idx is not None:
        try:
            win_id = window_id_by_index.get(int(active_idx))
            if win_id:
                tmux_queue(["select-window", "-t", win_id])
        except Exception:
            pass
    tmux_flush()
    if (reuse_current or session_empty) and original_window_ids:
        cleanup_command = " ; ".join(
            f"tmux kill-window -t {shlex.quote(window_id)}" for window_id in original_window_ids
        )
        tmux_out(["run-shell", "-b", f"sleep 0.1; {cleanup_command}"])


def main() -> int:
    parser = argparse.ArgumentParser(description="Restore tmux from tmux-dump JSON.")
    parser.add_argument("dump_file", help="Path to tmux-dump JSON file")
    parser.add_argument("-s", "--session", help="Target tmux session name")
    parser.add_argument("-c", "--directory", help="Base directory for new sessions/windows")
    parser.add_argument("-f", "--force", action="store_true", help="Clear target session before restore")
    parser.add_argument("-a", "--append", action="store_true", help="Append windows to target session")
    parser.add_argument(
        "--no-run-commands",
        action="store_false",
        dest="run_commands",
        help="Do not run pane commands during restore",
    )
    parser.set_defaults(run_commands=True)
    args = parser.parse_args()

    try:
        with open(args.dump_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        validate_dump(data)
    except Exception as exc:
        print(f"ERROR: failed to read dump file: {exc}", file=sys.stderr)
        return 2

    if args.force and args.append:
        print("ERROR: -f and -a cannot be used together", file=sys.stderr)
        return 2
    if args.directory:
        requested_dir = os.path.abspath(os.path.expanduser(args.directory))
        if not os.path.isdir(requested_dir):
            print(f"ERROR: directory does not exist: {requested_dir}", file=sys.stderr)
            return 2

    target_session = args.session
    dump_session = session_name_from_dump(data)
    current_session = current_session_name() if "TMUX" in os.environ else None
    in_tmux = current_session is not None
    if not target_session:
        if in_tmux:
            target_session = current_session
        else:
            target_session = dump_session

    if not target_session:
        print("ERROR: --session is required when dump has no session name and not inside tmux", file=sys.stderr)
        return 2

    if not in_tmux and not args.session and dump_session and not args.force and not args.append:
        if session_exists(dump_session):
            target_session = unique_session_name(dump_session)

    pending_rename = None
    if (
        not args.session
        and current_session
        and dump_session
        and target_session == current_session
        and dump_session != current_session
    ):
        new_name = dump_session
        if session_exists(new_name):
            new_name = unique_session_name(new_name)
        pending_rename = new_name

    if args.directory and in_tmux and current_session and target_session == current_session:
        print("ERROR: -c cannot be used when restoring in the current session", file=sys.stderr)
        return 2

    if in_tmux and current_session and target_session == current_session:
        base_dir = ""
        fallback_dir = ""
    else:
        base_dir = os.path.abspath(os.path.expanduser(args.directory)) if args.directory else ""
        fallback_dir = os.path.abspath(os.path.expanduser(os.getcwd()))

    try:
        restore_from_dump(data, args.force, args.append, args.run_commands, target_session, base_dir, fallback_dir)
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1

    try:
        if pending_rename and current_session:
            tmux_out(["rename-session", "-t", current_session, pending_rename])
            target_session = pending_rename
            current_session = pending_rename

        if in_tmux:
            if current_session != target_session:
                tmux_out(["switch-client", "-t", target_session])
        elif sys.stdin.isatty() and sys.stdout.isatty():
            tmux_out(["attach-session", "-t", target_session])
        else:
            print(f"Restored tmux session '{target_session}' (not attached: no terminal)")
    except Exception as exc:
        print(f"ERROR: session restored but client operation failed: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
