#!/usr/bin/env bash
# `dsh web` with the local no-token overlay in ../dsh; see ../dsh/README.md.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
overlay="$repo_root/dsh/overlay.yml"

if ! command -v dsh >/dev/null 2>&1; then
  echo "dsh-web: dsh not found on PATH; install DeepSeek Harness first" >&2
  exit 1
fi

exec dsh web --patch "$overlay" --no-open "$@"
