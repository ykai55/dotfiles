#!/usr/bin/env bash

set -euo pipefail

for command_name in slurp grim wl-copy; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "screenshot-region: missing required command: $command_name" >&2
    exit 1
  fi
done

if ! geometry="$(slurp)"; then
  exit 0
fi

if [[ -z "$geometry" ]]; then
  exit 0
fi

grim -g "$geometry" - | wl-copy --type image/png
