#!/usr/bin/env bash
# task-watch — 反复运行 job 命令，直到完成 / 需要处理 / 到达截止时间。
#
# 用法: task-watch --until <epoch秒> [--interval 60] [--max-block 540] -- <job 命令...>
# 退出码: 0 完成 / 1 仍在运行 / 10 需要 agent 判断 / 20 致命
#
# --until     绝对截止时间（epoch 秒），必填。
# --interval  两次检查之间的间隔秒数，默认 60。
# --max-block 单次调用最多阻塞的秒数，默认 540；必须小于调用方的超时。
#
# 注意: 不使用 set -e —— 需要读取 job 的非零退出码。

set -uo pipefail

interval=60
until=0
max_block=540
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      printf 'usage: task-watch --until <epoch秒> [--interval 60] [--max-block 540] -- <job 命令...>\n'
      exit 0 ;;
    --interval)  interval=$2; shift 2 ;;
    --until)     until=$2; shift 2 ;;
    --max-block) max_block=$2; shift 2 ;;
    --)          shift; break ;;
    *) echo "[task-watch] 未知参数: $1" >&2; exit 20 ;;
  esac
done
[[ $# -gt 0 ]] || { echo "[task-watch] 缺少 job 命令" >&2; exit 20; }
[[ $until -gt 0 ]] || { echo "[task-watch] 必须指定 --until <epoch秒>" >&2; exit 20; }

start=$(date +%s)
budget_end=$((start + max_block))
[[ $budget_end -gt $until ]] && budget_end=$until

last=""
while :; do
  out=$("$@" 2>>"${WATCH_LOG:-/dev/null}"); code=$?
  [[ -n $out ]] && last=$(printf '%s' "$out" | tail -n 1)
  case $code in
    0)  printf '[task-watch] 完成: %s\n' "$last"; exit 0 ;;
    1)  : ;;
    10) printf '[task-watch] 需要处理: %s\n' "$last"; exit 10 ;;
    *)  printf '[task-watch] 错误(退出码 %s): %s\n' "$code" "$last" >&2; exit 20 ;;
  esac
  now=$(date +%s)
  [[ $now -ge $budget_end ]] && { printf '[task-watch] 仍在运行: %s\n' "$last"; exit 1; }
  nap=$interval
  [[ $((now + nap)) -gt $budget_end ]] && nap=$((budget_end - now))
  [[ $nap -gt 0 ]] && sleep "$nap"
done
