# OpenAI-compatible provider settings used by opencode-provider-gen and provider-loader.ts.
# Include /v1 or another required API prefix. Do not use /models or a completion endpoint.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Empty by default. Set this before exposing opencode beyond localhost.
OPENCODE_SERVER_PASSWORD=
# Optional. Defaults to $HOME from the shell running docker compose.
# OPENCODE_WORKDIR=/path/to/workdir
# Optional. Use "auto" to benchmark mirrors at build time, or set a Debian mirror URL.
# DEBIAN_MIRROR=auto
